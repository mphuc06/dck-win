{
  "name": "380 - oprekin 11 26H2 Lite Plus",
  "service": "windows",
  "containerEnv": {
    "VERSION": "https://archive.org/download/win-11-pro-26-h-2.9457-lp/Win11Pro_26H2.9457_LP_.iso"
  },
  "forwardPorts": [8006],  
  "portsAttributes": {
    "8006": {
      "label": "Web",
      "onAutoForward": "notify"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  }, 
  "dockerComposeFile": "../codespaces.yml",
  "initializeCommand": "docker system prune --all --force"
}
